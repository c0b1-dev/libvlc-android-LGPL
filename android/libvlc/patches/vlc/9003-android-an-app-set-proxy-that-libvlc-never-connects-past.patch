diff --git a/src/android/specific.c b/src/android/specific.c
index 89642ad..1d63a8b 100644
--- a/src/android/specific.c
+++ b/src/android/specific.c
@@ -32,7 +32,9 @@
 #include "../config/configuration.h"
 
 #include <string.h>
+#include <strings.h>
 #include <jni.h>
+#include <vlc_url.h>
 
 static JavaVM *s_jvm = NULL;
 #define GENERIC_DIR_COUNT (VLC_SNAPSHOTS_DIR - VLC_DESKTOP_DIR + 1)
@@ -331,10 +333,128 @@ char *config_GetSysPath(vlc_sysdir_t type, const char *filename)
     return path;
 }
 
-char *vlc_getProxyUrl(const char *url)
+/* [Cobi 9003] A proxy the host app sets for this process, the twin of Apple's
+ * patch 0007 (src/darwin/netconf.m there). Cobi Player routes only its own
+ * traffic through the user's VPN or proxy, via an in-process gateway on
+ * 127.0.0.1 that takes a fresh login on every start, so no other process on
+ * the device can use it. The app sets the Java system property below to
+ * "http://user:pass@127.0.0.1:port" (percent-encoded), and clears it for none:
+ * then everything behaves as before.
+ *
+ * While one is set, libVLC never connects past it:
+ * - the schemes in app_proxy_routed go to it: "https" as CONNECT (tunnel.c),
+ *   the others as absolute-form requests (http/connmgr.c, legacy http.c for
+ *   icyx/unsv/itpc, mmsh.c). If it is down, they fail; nothing goes direct.
+ *   It comes before the device's own proxy (http.proxyHost).
+ * - access_New() (src/input/access.c) refuses every scheme that is neither
+ *   routed nor in app_proxy_local, also after a redirect: the http module
+ *   turns ICY answers into icyx:// and "Pragma: features" into mmsh://, and a
+ *   Location may name any scheme (rtsp, ftp, smb, ...).
+ * A login in the URL goes to the proxy as Basic Proxy-Authorization on every
+ * request, so the proxy can turn away any other process. The debug log never
+ * shows it. Read through System.getProperty, the call below already makes for
+ * http.proxyHost: no new JNI symbol, no libvlcjni change. */
+#define APP_PROXY_PROPERTY "ch.codebits.cobiplayer.proxy"
+
+static const char *const app_proxy_routed[] = {
+    "http", "https", "icyx", "unsv", "itpc", "mmsh", NULL
+};
+static const char *const app_proxy_local[] = {
+    "file", "fd", "stream", "directory", "dir", "concat", "list", "data",
+    "imem", "dummy", "vlc", NULL
+};
+
+/* Nothing listens on port 1: what a bad proxy URL is replaced with, so that
+ * it fails every connection instead of meaning "no proxy". */
+static const char app_proxy_closed[] = "http://127.0.0.1:1";
+
+static bool scheme_in(const char *scheme, size_t len, const char *const *list)
+{
+    for (; *list != NULL; list++)
+        if (strlen(*list) == len && strncasecmp(scheme, *list, len) == 0)
+            return true;
+    return false;
+}
+
+/* "http://[user:pass@]host:port[/]" and nothing else. An unencoded '/' or '?'
+ * in the login would make vlc_UrlParse() read a different host. */
+static bool app_proxy_valid(const char *proxy_url)
+{
+    vlc_url_t url;
+    bool ok = vlc_UrlParse(&url, proxy_url) == 0
+        && url.psz_protocol != NULL && strcasecmp(url.psz_protocol, "http") == 0
+        && url.psz_host != NULL && url.psz_host[0] != '\0'
+        && url.i_port > 0 && url.i_port <= 65535
+        && (url.psz_path == NULL || strcmp(url.psz_path, "/") == 0)
+        && url.psz_option == NULL && url.psz_fragment == NULL;
+    vlc_UrlClean(&url);
+    return ok;
+}
+
+/* The app's proxy as the property says now: NULL if it is not set, a copy of
+ * it if valid, else the closed port. When it can't be read, the closed port:
+ * NULL would mean "go direct". Out of memory aborts for the same reason. */
+static char *app_proxy_read(JNIEnv *env)
+{
+    const char *proxy = app_proxy_closed;
+    jstring jkey = (*env)->NewStringUTF(env, APP_PROXY_PROPERTY);
+    jstring jvalue = NULL;
+    if (jkey != NULL)
+        jvalue = (*env)->CallStaticObjectMethod(env, fields.System.clazz,
+                                                fields.System.getProperty, jkey);
+    if ((*env)->ExceptionCheck(env))
+    {
+        (*env)->ExceptionClear(env);
+        jvalue = NULL; /* not read: stays the closed port */
+    }
+    else if (jkey != NULL && jvalue == NULL)
+        proxy = NULL; /* not set */
+
+    const char *value = NULL;
+    if (jvalue != NULL)
+    {
+        value = (*env)->GetStringUTFChars(env, jvalue, NULL);
+        if (value != NULL && app_proxy_valid(value))
+            proxy = value;
+    }
+    char *copy = proxy != NULL ? strdup(proxy) : NULL;
+    if (value != NULL)
+        (*env)->ReleaseStringUTFChars(env, jvalue, value);
+    if (jvalue != NULL)
+        (*env)->DeleteLocalRef(env, jvalue);
+    if (jkey != NULL)
+        (*env)->DeleteLocalRef(env, jkey);
+    if (unlikely(proxy != NULL && copy == NULL))
+        abort();
+    return copy;
+}
+
+bool vlc_android_AppProxyAllowsScheme(const char *scheme)
 {
-    VLC_UNUSED(url);
+    size_t len = strlen(scheme);
+    if (scheme_in(scheme, len, app_proxy_routed)
+     || scheme_in(scheme, len, app_proxy_local))
+        return true;
 
+    bool b_detach;
+    JNIEnv *env = get_env(&b_detach);
+    if (env == NULL)
+        return false; /* whether one is set is unknown: refuse */
+    char *proxy = app_proxy_read(env);
+    release_env(b_detach);
+    bool set = proxy != NULL;
+    free(proxy);
+    return !set;
+}
+
+static bool app_proxy_routes(const char *url)
+{
+    const char *colon = strchr(url, ':');
+    return colon != NULL && scheme_in(url, colon - url, app_proxy_routed);
+}
+
+char *vlc_getProxyUrl(const char *url)
+{
     /**
      * Determines the network proxy server to use (if any).
      *
@@ -351,7 +471,23 @@ char *vlc_getProxyUrl(const char *url)
 
     env = get_env(&b_detach);
     if (env == NULL)
-        return NULL;
+    {
+        /* [Cobi 9003] Whether the app's proxy is set is unknown: never direct. */
+        if (url == NULL || !app_proxy_routes(url))
+            return NULL;
+        char *closed = strdup(app_proxy_closed);
+        if (unlikely(closed == NULL))
+            abort();
+        return closed;
+    }
+
+    /* [Cobi 9003] The app's proxy first (see above). */
+    if (url != NULL && app_proxy_routes(url))
+    {
+        psz_ret = app_proxy_read(env);
+        if (psz_ret != NULL)
+            goto end;
+    }
 
     /* Fetch "http.proxyHost" property */
     jstring jkey = (*env)->NewStringUTF(env, "http.proxyHost");
diff --git a/src/input/access.c b/src/input/access.c
index 6831ed8..7d9af3a 100644
--- a/src/input/access.c
+++ b/src/input/access.c
@@ -35,6 +35,7 @@
 #include <vlc_access.h>
 
 #include "stream.h"
+#include "../libvlc.h"
 
