diff --git a/modules/access/http/connmgr.c b/modules/access/http/connmgr.c
index ca73485..5fde68e 100644
--- a/modules/access/http/connmgr.c
+++ b/modules/access/http/connmgr.c
@@ -95,6 +95,19 @@ static char *vlc_http_proxy_find(const char *hostname, unsigned port,
     return proxy;
 }
 
+/* [Cobi 0007] Adds a Basic Proxy-Authorization from the proxy URL's userinfo
+ * ("http://user:pass@host:port"), the login tunnel.c already sends on CONNECT
+ * and the legacy http.c on every request. */
+static int vlc_http_proxy_add_creds(struct vlc_http_msg *req,
+                                    const vlc_url_t *proxy)
+{
+    if (proxy->psz_username == NULL)
+        return 0;
+    return vlc_http_msg_add_creds_basic(req, true, proxy->psz_username,
+                                        proxy->psz_password != NULL
+                                        ? proxy->psz_password : "");
+}
+
 
 struct vlc_http_mgr
 {
@@ -103,6 +116,7 @@ struct vlc_http_mgr
     vlc_tls_client_t *creds;
     struct vlc_http_cookie_jar_t *jar;
     struct vlc_http_conn *conn;
+    char *route; /* [Cobi 0007] the proxy conn was opened through, or NULL */
 };
 
 static struct vlc_http_conn *vlc_http_mgr_find(struct vlc_http_mgr *mgr,
@@ -117,10 +131,37 @@ static void vlc_http_mgr_release(struct vlc_http_mgr *mgr,
 {
     assert(mgr->conn == conn);
     mgr->conn = NULL;
+    free(mgr->route);
+    mgr->route = NULL;
 
     vlc_http_conn_release(conn);
 }
 
+/* [Cobi 0007] Drops mgr->conn unless it was opened the way this request goes:
+ * through the same proxy, or both directly. A keep-alive connection must not
+ * carry a request past a proxy set since, nor the proxy's login to an origin. */
+static void vlc_http_mgr_check_route(struct vlc_http_mgr *mgr,
+                                     const char *proxy)
+{
+    if (mgr->conn == NULL)
+        return;
+    if (proxy == NULL ? mgr->route == NULL
+                      : mgr->route != NULL && strcmp(mgr->route, proxy) == 0)
+        return;
+    vlc_http_mgr_release(mgr, mgr->conn);
+}
+
+/* [Cobi 0007] Makes conn, opened through route (or directly if NULL), the
+ * connection to reuse. Takes ownership of route. */
+static void vlc_http_mgr_attach(struct vlc_http_mgr *mgr,
+                                struct vlc_http_conn *conn, char *route)
+{
+    if (mgr->conn != NULL)
+        vlc_http_mgr_release(mgr, mgr->conn);
+    mgr->conn = conn;
+    mgr->route = route;
+}
+
 static
 struct vlc_http_msg *vlc_http_mgr_reuse(struct vlc_http_mgr *mgr,
                                         const char *host, unsigned port,
@@ -161,6 +202,10 @@ static struct vlc_http_msg *vlc_https_request(struct vlc_http_mgr *mgr,
             return NULL;
     }
 
+    /* [Cobi 0007] One proxy lookup per request, for reuse and connecting. */
+    char *proxy = vlc_http_proxy_find(host, port, true);
+    vlc_http_mgr_check_route(mgr, proxy);
+
     if (idempotent)
     {   /* If the request is idempotent, try to reuse an existing connection.
          * Otherwise, it is possible but unadvisable as we would not know if
@@ -170,21 +215,23 @@ static struct vlc_http_msg *vlc_https_request(struct vlc_http_mgr *mgr,
         struct vlc_http_msg *resp = vlc_http_mgr_reuse(mgr, host, port, req,
                                                        payload);
         if (resp != NULL)
+        {
+            free(proxy);
             return resp; /* existing connection reused */
+        }
     }
 
-    char *proxy = vlc_http_proxy_find(host, port, true);
     if (proxy != NULL)
-    {
         tls = vlc_https_connect_proxy(mgr->creds, mgr->creds,
                                       host, port, &http2, proxy);
-        free(proxy);
-    }
     else
         tls = vlc_https_connect(mgr->creds, host, port, &http2);
 
     if (tls == NULL)
+    {
+        free(proxy);
         return NULL;
+    }
 
     struct vlc_http_conn *conn;
 
@@ -203,13 +250,11 @@ static struct vlc_http_msg *vlc_https_request(struct vlc_http_mgr *mgr,
     if (unlikely(conn == NULL))
     {
         vlc_tls_Close(tls);
+        free(proxy);
         return NULL;
     }
 
-    if (mgr->conn != NULL)
-        vlc_http_mgr_release(mgr, mgr->conn);
-
-    mgr->conn = conn;
+    vlc_http_mgr_attach(mgr, conn, proxy);
     return vlc_http_mgr_reuse(mgr, host, port, req, payload);
 }
 
@@ -221,52 +266,60 @@ static struct vlc_http_msg *vlc_http_request(struct vlc_http_mgr *mgr,
     if (mgr->creds != NULL && mgr->conn != NULL)
         return NULL; /* switch from HTTPS to HTTP not implemented */
 
-    if (idempotent)
+    /* [Cobi 0007] One proxy lookup per request, for reuse, the login and
+     * connecting. After the route check, the request goes to the proxy if and
+     * only if one is set, so its login goes nowhere else. Both callers
+     * (resource.c, outfile.c) build the request for this one call and destroy
+     * it afterwards, so adding a header is safe. A proxy URL that can't be
+     * read, or a login that can't be sent, fails the request. */
+    char *proxy = vlc_http_proxy_find(host, port, false);
+    const bool proxied = proxy != NULL;
+    vlc_url_t url;
+
+    if (proxied
+     && (vlc_UrlParse(&url, proxy) != 0 || url.psz_host == NULL
+      || vlc_http_proxy_add_creds((struct vlc_http_msg *)req, &url)))
     {
-        struct vlc_http_msg *resp = vlc_http_mgr_reuse(mgr, host, port, req,
-                                                       payload);
-        if (resp != NULL)
-            return resp;
+        vlc_UrlClean(&url);
+        free(proxy);
+        return NULL;
     }
+    vlc_http_mgr_check_route(mgr, proxy);
 
-    struct vlc_http_conn *conn;
-    struct vlc_http_stream *stream;
+    struct vlc_http_msg *resp = NULL;
 
-    char *proxy = vlc_http_proxy_find(host, port, false);
-    if (proxy != NULL)
-    {
-        vlc_url_t url;
+    if (idempotent)
+        resp = vlc_http_mgr_reuse(mgr, host, port, req, payload);
 
-        vlc_UrlParse(&url, proxy);
-        free(proxy);
+    if (resp == NULL)
+    {
+        struct vlc_http_conn *conn;
+        struct vlc_http_stream *stream;
 
-        if (url.psz_host != NULL)
+        if (proxied)
             stream = vlc_h1_request(mgr->logger, url.psz_host,
                                     url.i_port ? url.i_port : 80, true, req,
                                     idempotent, payload, &conn);
         else
-            stream = NULL;
-
-        vlc_UrlClean(&url);
-    }
-    else
-        stream = vlc_h1_request(mgr->logger, host, port ? port : 80, false,
-                                req, idempotent, payload, &conn);
-
-    if (stream == NULL)
-        return NULL;
-
-    struct vlc_http_msg *resp = vlc_http_msg_get_initial(stream);
-    if (resp == NULL)
-    {
-        vlc_http_conn_release(conn);
-        return NULL;
+            stream = vlc_h1_request(mgr->logger, host, port ? port : 80,
+                                    false, req, idempotent, payload, &conn);
+
+        if (stream != NULL)
+        {
+            resp = vlc_http_msg_get_initial(stream);
+            if (resp == NULL)
+                vlc_http_conn_release(conn);
+            else
+            {
+                vlc_http_mgr_attach(mgr, conn, proxy);
+                proxy = NULL; /* now mgr->route */
+            }
+        }
     }
 
-    if (mgr->conn != NULL)
-        vlc_http_mgr_release(mgr, mgr->conn);
-
-    mgr->conn = conn;
+    if (proxied)
+        vlc_UrlClean(&url);
+    free(proxy);
     return resp;
 }
 
@@ -299,6 +352,7 @@ struct vlc_http_mgr *vlc_http_mgr_create(vlc_object_t *obj,
     mgr->creds = NULL;
     mgr->jar = jar;
     mgr->conn = NULL;
+    mgr->route = NULL;
     return mgr;
 }
 
