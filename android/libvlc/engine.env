# The libVLC 4 the Android app plays with (openspec android-port, design D11, task 6.3).
# Read by android/libvlc/*.sh and .github/workflows/android-libvlc.yml. Plain KEY=value lines.
#
# ONE pin: a commit of VideoLAN's libvlcjni (the Android bindings). Everything else follows from
# that commit's own files, so the three can never drift apart:
#   - the VLC commit: VLC_TESTED_HASH in its buildsystem/get-vlc.sh, plus its Android patches
#     (libvlc/patches/, applied by get-vlc.sh);
#   - the build image (NDK, SDK, gradle): `image:` in its buildsystem/gitlab/.gitlab-ci.yml.
# This is the pair VideoLAN tests VLC for Android with. On top of it we build LGPL only
# (`--license l`), keep the GPL zvbi, VLC's GPL modules, Lua and yadif out and apply our fixes
# (patches/libvlcjni/, patches/vlc/; build.sh).
#
# Apple's engine is an older VLC 4 with our patch 0006 (MP4 seeking) backported. The VLC pinned
# through this commit must already contain that fix upstream; build.sh refuses one without it.
#
# Changing the pin rebuilds libVLC (about 2–3 hours on GitHub Actions per ABI).

LIBVLCJNI_REPO=https://code.videolan.org/videolan/libvlcjni.git
LIBVLCJNI_COMMIT=a8d53a9151d7e4a9a5dfd0a5eb1cd92669afdc21

# Phones are 64-bit; Google still requires 32-bit code in a TV app (TV-G6), so both ship.
ABIS="arm64-v8a armeabi-v7a"

# The libraries the package carries for each ABI, and the app ships: check.sh allows no other (rule 1);
# Scripts/android-release-check.py and Scripts/android-bundle-size.py read them here.
LIBS="libvlc.so libvlcjni.so libc++_shared.so"
